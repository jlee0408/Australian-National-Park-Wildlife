{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelColor": "#34483a",
      "titleColor": "#34483a",
      "gridColor": "#e8eee7"
    },
    "legend": {
      "labelColor": "#34483a",
      "titleColor": "#34483a"
    }
  },
  "description": "C7: Total waterbird individuals counted in the UNSW aerial waterbird surveys by survey year. Counts reflect survey coverage in each year.",
  "data": {
    "url": "data/UNSW%20Aerial%20Survey%20Waterbirds%201983-2019%201a.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Year)",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.Sum_of_count)",
      "as": "birdCount"
    },
    {
      "filter": "isValid(datum.year) && isValid(datum.birdCount)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "birdCount",
          "as": "totalBirds"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 45
    },
    "strokeWidth": 2.5,
    "color": "#b85f2c"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Survey year",
      "axis": {
        "format": "d",
        "tickCount": 8
      }
    },
    "y": {
      "field": "totalBirds",
      "type": "quantitative",
      "title": "Sum of birds counted",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ".2s"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "totalBirds",
        "type": "quantitative",
        "title": "Birds counted",
        "format": ",.0f"
      }
    ]
  }
}