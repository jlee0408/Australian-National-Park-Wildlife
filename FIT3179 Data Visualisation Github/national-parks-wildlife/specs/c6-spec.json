{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelColor": "#34483a",
      "titleColor": "#34483a",
      "gridColor": "#e8eee7"
    },
    "legend": {
      "labelColor": "#34483a",
      "titleColor": "#34483a"
    }
  },
  "description": "C6: Threatened Species Index trend for the selected terrestrial group, with supplied low/high bounds.",
  "data": {
    "url": "data/tsx-trend-dataset=tsx2024%26type=all%26tgroup=All%26group=Terrestrial%26subgroup=All%26state=All%26statusauth=Max%26status=NT_VU_EN_CR%26management=All%26refyear=1985.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.year)",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.value)",
      "as": "indexValue"
    },
    {
      "calculate": "toNumber(datum.low)",
      "as": "lowValue"
    },
    {
      "calculate": "toNumber(datum.high)",
      "as": "highValue"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.18,
        "color": "#7da58a"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d",
            "tickCount": 8
          }
        },
        "y": {
          "field": "lowValue",
          "type": "quantitative",
          "title": "TSX index (1985 = 1)",
          "scale": {
            "zero": false
          }
        },
        "y2": {
          "field": "highValue"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#244d38",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 25
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d",
            "tickCount": 8
          }
        },
        "y": {
          "field": "indexValue",
          "type": "quantitative",
          "title": "TSX index (1985 = 1)",
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "indexValue",
            "type": "quantitative",
            "title": "Index",
            "format": ".3f"
          },
          {
            "field": "lowValue",
            "type": "quantitative",
            "title": "Lower bound",
            "format": ".3f"
          },
          {
            "field": "highValue",
            "type": "quantitative",
            "title": "Upper bound",
            "format": ".3f"
          }
        ]
      }
    }
  ]
}