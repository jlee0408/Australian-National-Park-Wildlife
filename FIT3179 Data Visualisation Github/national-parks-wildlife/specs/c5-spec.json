{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelColor": "#34483a",
      "titleColor": "#34483a",
      "gridColor": "#e8eee7"
    },
    "legend": {
      "labelColor": "#34483a",
      "titleColor": "#34483a"
    }
  },
  "description": "C5: States and territories ranked by natural terrestrial woody vegetation area in 2024.",
  "data": {
    "url": "data/Time%20series%20for%20Land%20Cover%20Stock%20Positions%2C%20states%20and%20territories%2C%201988%20to%202024%20%28hectares%29.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum['Land cover classes'] === 'Natural terrestrial vegetated: Woody'"
    },
    {
      "fold": [
        "1988",
        "1989",
        "1990",
        "1991",
        "1992",
        "1993",
        "1994",
        "1995",
        "1996",
        "1997",
        "1998",
        "1999",
        "2000",
        "2001",
        "2002",
        "2003",
        "2004",
        "2005",
        "2006",
        "2007",
        "2008",
        "2009",
        "2010",
        "2011",
        "2012",
        "2013",
        "2014",
        "2015",
        "2016",
        "2017",
        "2018",
        "2019",
        "2020",
        "2021",
        "2022",
        "2023",
        "2024"
      ],
      "as": [
        "year",
        "areaRaw"
      ]
    },
    {
      "filter": "datum.year === '2024'"
    },
    {
      "calculate": "toNumber(replace(datum.areaRaw, /,/g, \"\"))",
      "as": "areaHa"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "States and territories",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 190
      }
    },
    "x": {
      "field": "areaHa",
      "type": "quantitative",
      "title": "Natural woody vegetation (ha)",
      "axis": {
        "format": ".2s"
      }
    },
    "color": {
      "value": "#47785b"
    },
    "tooltip": [
      {
        "field": "States and territories",
        "type": "nominal",
        "title": "State/territory"
      },
      {
        "field": "areaHa",
        "type": "quantitative",
        "title": "Area (ha)",
        "format": ",.0f"
      }
    ]
  }
}