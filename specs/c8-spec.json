{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelColor": "#34483a",
      "titleColor": "#34483a",
      "gridColor": "#e8eee7"
    },
    "legend": {
      "labelColor": "#34483a",
      "titleColor": "#34483a"
    }
  },
  "description": "C8: Ten data resources with the largest counts in the environmental monitoring source summary.",
  "data": {
    "url": "data/data_sources_env_monitoring.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.count)",
      "as": "recordCount"
    },
    {
      "filter": "isValid(datum.recordCount)"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "recordCount",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 10"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "color": "#47785b"
  },
  "encoding": {
    "y": {
      "field": "dataResourceName",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 250
      }
    },
    "x": {
      "field": "recordCount",
      "type": "quantitative",
      "title": "Records reported",
      "axis": {
        "format": ".2s"
      }
    },
    "tooltip": [
      {
        "field": "dataResourceName",
        "type": "nominal",
        "title": "Data resource"
      },
      {
        "field": "recordCount",
        "type": "quantitative",
        "title": "Count",
        "format": ",.0f"
      }
    ]
  }
}