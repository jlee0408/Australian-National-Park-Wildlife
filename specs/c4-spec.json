{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelColor": "#34483a",
      "titleColor": "#34483a",
      "gridColor": "#e8eee7"
    },
    "legend": {
      "labelColor": "#34483a",
      "titleColor": "#34483a"
    }
  },
  "description": "C4: Australian land-cover composition as reported proportions, 1988–2024.",
  "data": {
    "url": "data/Proportion%20of%20land%20cover%20classes%2C%20Australia%201988%E2%80%932024.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "Herbaceous crops (%)",
        "Grassland (%)",
        "Tree covered areas (%)",
        "Sparsely vegetated areas (%)",
        "Other land cover* (%)"
      ],
      "as": [
        "landCoverClass",
        "proportion"
      ]
    },
    {
      "calculate": "toNumber(datum.Year)",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.proportion)",
      "as": "share"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 25
    },
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "zero": false
      },
      "axis": {
        "format": "d",
        "tickCount": 8
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "title": "Land cover (%)",
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "landCoverClass",
      "type": "nominal",
      "title": "Land-cover class"
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "landCoverClass",
        "type": "nominal",
        "title": "Land-cover class"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      }
    ]
  }
}